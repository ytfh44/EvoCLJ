;; component fixture — G1 topology (test/fixtures/evolution-e2e/route-a).
;;
;; The route program (programs/route.clj) is the decision-maker: for
;; every request it EMITS a typed intent, which the component scheduler
;; dispatches through the kernel-owned broker. The :emit node
;; completes the session with the accumulated outputs. Acyclic, so it
;; compiles under the step budget.
{:graph/id :graph/e2e
 :entry :node/router
 :nodes
 {:node/router {:node/type :sci
                :program :program/route
                :next :node/emit}
  :node/emit   {:node/type :emit}}
 :limits {:max-steps 64}}
